# Override gitignore for EAS builds — include sensitive files needed at build time.
# google-services.json is gitignored but must be present for Android prebuild.
!google-services.json

# CNG: native dirs are regenerated by `expo prebuild` in the cloud. Never upload
# local prebuild output (Pods, .gradle, build artifacts) — it skips prebuild and
# bloats the archive. app.config.js is the source of truth.
/ios/
/android/

# Downloaded build artifacts and local exports — never needed by EAS Build.
# (.easignore replaces .gitignore entirely, so these must be listed explicitly.)
*.apk
*.aab
*.ipa
/dist/
/.expo/
/test-results/
/playwright-report/
/coverage/
/e2e/test-results/
*.log
