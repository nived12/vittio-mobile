# Copy this file to .env.local and fill in your values.
# Expo reads .env.local automatically. Only EXPO_PUBLIC_* vars are exposed to the client bundle.

# ── API ───────────────────────────────────────────────────────────────────────
# Rails API base URL.
# Local dev (simulator/emulator on same machine): http://localhost:3000/api/v1
# Local dev (physical device on same network): http://<your-machine-ip>:3000/api/v1
# Production: https://your-production-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Legal URLs ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_TERMS_URL=http://localhost:3000/terms
EXPO_PUBLIC_PRIVACY_URL=http://localhost:3000/privacy
