# Copy this file to .env.local and fill in your values.
# Expo reads .env.local automatically. Only EXPO_PUBLIC_* vars are exposed to the client bundle.

# ── API ───────────────────────────────────────────────────────────────────────
# Rails API base URL.
# Local dev (simulator/emulator on same machine): http://localhost:3000/api/v1
# Local dev (physical device on same network): http://<your-machine-ip>:3000/api/v1
# Production: https://your-production-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Create project at https://sentry.io — platform: React Native
# Only active in production builds (enabled: !__DEV__ in _layout.tsx)
# EXPO_PUBLIC_SENTRY_DSN=https://your_key@oXXXXX.ingest.sentry.io/your_project_id

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
# Create project at https://eu.posthog.com — EU cloud for LFPDPPP compliance
# Leave blank in dev to disable (no-op). See app/_layout.tsx
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key

# ── Legal URLs ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_TERMS_URL=http://localhost:3000/legal/terms
EXPO_PUBLIC_PRIVACY_URL=http://localhost:3000/legal/privacy
